{
	// Hébergement sur Cloudflare Workers (adaptateur OpenNext). Doc : https://opennext.js.org/cloudflare
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "joyeuxevent",
	"main": "worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{ "binding": "WORKER_SELF_REFERENCE", "service": "joyeuxevent" }
	],
	// Récapitulatif quotidien des réponses aux mariés (17 h UTC), voir worker.ts.
	"triggers": { "crons": ["0 17 * * *"] },
	// Variables non secrètes. Les secrets (SUPABASE_SERVICE_ROLE_KEY, BREVO_API_KEY, CRON_SECRET)
	// sont saisis par Glad dans le tableau de bord Cloudflare, jamais ici.
	// keep_vars : un déploiement (push sur main) ne doit PAS effacer les secrets saisis dans le tableau de bord.
	"keep_vars": true,
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://ecartestudio.com",
		"SUPABASE_URL": "https://usolfegmepnazrporeec.supabase.co",
		"EMAIL_FROM": "E-carte Studio <hello@ecartestudio.com>",
		// Paiement Stripe à la publication : passer à "true" une fois STRIPE_SECRET_KEY et STRIPE_WEBHOOK_SECRET saisis.
		"PAYMENTS_ENABLED": "true",
		// Statistiques de l'admin (Cloudflare Web Analytics, site « Automatic setup » : le script est injecté par Cloudflare,
		// donc CF_WEB_ANALYTICS_TOKEN reste vide pour ne pas compter deux fois). CF_API_TOKEN est un secret saisi dans le tableau de bord.
		"CF_ACCOUNT_ID": "4a119a4ba99c3c4374be69e577a105b7",
		"CF_WEB_ANALYTICS_SITE_TAG": "a0e758c1ef0f4c3e8e8343b3f5cf667c"
	},
	"observability": { "enabled": true }
}
