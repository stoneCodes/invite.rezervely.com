# Copier en .env.local (en local) et dans Vercel > Settings > Environment Variables
NEXT_PUBLIC_SITE_URL=https://joyeuxevent.com
SUPABASE_URL=https://usolfegmepnazrporeec.supabase.co
# Supabase > Project Settings > API Keys > service_role (secret, jamais côté navigateur)
SUPABASE_SERVICE_ROLE_KEY=
# Laisser à false tant que Stripe n'est pas branché : "Publier" publie directement
PAYMENTS_ENABLED=false

# E-mails aux mariés (Brevo, API transactionnelle). Sans clé : mode test, les e-mails s'affichent dans le terminal.
# Brevo > SMTP & API > Clés API. Clé secrète : à saisir directement dans Vercel, jamais dans le code ni le chat.
BREVO_API_KEY=
# Expéditeur : le domaine doit être authentifié dans Brevo (enregistrements DNS chez Cloudflare)
EMAIL_FROM=joyeuxevent <hello@joyeuxevent.com>
# Facultatif : adresse qui reçoit les réponses des mariés
EMAIL_REPLY_TO=
# Secret du récapitulatif quotidien (vercel.json > crons). Vercel l'envoie dans l'en-tête Authorization.
CRON_SECRET=

# Connexion administrateur (à saisir en secrets Cloudflare ; jamais dans le chat ou le code)
ADMIN_EMAILS=
ADMIN_SESSION_SECRET=

# Statistiques Cloudflare Web Analytics (identifiants non secrets + jeton secret)
CF_ACCOUNT_ID=
CF_WEB_ANALYTICS_SITE_TAG=
# Secret : permission Account Analytics: Read, à saisir directement dans Cloudflare
CF_API_TOKEN=
